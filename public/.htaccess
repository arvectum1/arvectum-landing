DirectoryIndex index.html
Options -Indexes

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.env$ - [F,L,NC]
  RewriteRule ^api/storage/ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
